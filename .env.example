# ==========================================
# FRONTEND — VITE
# ==========================================

# Public API endpoint.
# Replace with the actual Vercel deployment URL.
VITE_API_BASE_URL=http://localhost:5173
# VITE_API_BASE_URL=https://api.hayaxxdev-bit.my.id

# ==========================================
# BACKEND — VERCEL FUNCTIONS
# ==========================================

# GitHub Personal Access Token.
# Never expose this variable to frontend.
GITHUB_TOKEN=

# GitHub REST API version.
GITHUB_API_VERSION=2022-11-28

# Comma-separated allowed frontend origins.
API_ALLOWED_ORIGINS=http://localhost:5173,https://hayaxxdev-bit.my.id